<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_mis_budget_form_view" model="ir.ui.view">
        <field name="name">mis.budget.form</field>
        <field name="model">mis.budget</field>
        <field name="inherit_id" ref="mis_builder_budget.mis_budget_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_id']" position="after">
                <field name="project_id" groups="project.group_project_user"/>
                <field name="analytic_account_project_id" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']/button" position="attributes">
                <attribute name="context">{'default_analytic_account_id': analytic_account_project_id}</attribute>
            </xpath>
        </field>
    </record>

    <record id="mis_budget_tree_view" model="ir.ui.view">
        <field name="name">mis.budget.tree</field>
        <field name="model">mis.budget</field>
        <field name="inherit_id" ref="mis_builder_budget.mis_budget_tree_view" />
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <button name="action_duplicate" icon="fa-copy" class="p-0" type="object" title="Duplicate"/>
            </field>
        </field>
    </record>

</odoo>
