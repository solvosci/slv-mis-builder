<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_mis_report_form_view" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page[2]" position="before">
                <page name="mis_report" string="Mis Report">
                    <field name="is_group_account_manager" invisible="1"/>
                    <field name="is_group_project_manager" invisible="1"/>
                    <group>
                        <group name="mis_report_group">
                            <field name="mis_report_template_id" attrs="{'readonly': [('is_group_project_manager', '=', False)]}"/>
                            <field name="mis_report_instance_id" readonly="1"/>
                        </group>
                        <group name="mis_report_group2">
                            <button 
                                name="auto_create_mis_instance"
                                string="Autocreate"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': ['|', ('is_group_account_manager', '=', False), ('mis_report_instance_id', '!=', False)]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_buttom_kanban_view" model="ir.ui.view">
        <field name="name">project.project.kanban</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mis_report_instance_id" invisible="1"/>
            </xpath>
            <xpath expr="//span[hasclass('o_text_overflow')]" position="before">
                <a 
                    name="action_mis_report_preview"
                    type="object"
                    class="o_text_overflow fa fa-bar-chart-o pt-1"
                    attrs="{'invisible': [('mis_report_instance_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record> 

</odoo>
