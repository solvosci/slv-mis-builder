<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_mis_export_wizard_form" model="ir.ui.view">
        <field name="name">project.mis.export.wizard.form</field>
        <field name="model">project.mis.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="account_analytic_ids" widget="many2many_tags" required="1"/>
                        </group>
                        <group >
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_export_xlsx" string="Export" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
